# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/pizza-delivery

# Client / Frontend Origin
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# App Branding
APP_NAME=Pizza Slice

# Restaurant Location & Delivery Radius Configuration
RESTAURANT_LATITUDE=19.0760
RESTAURANT_LONGITUDE=72.8777
DELIVERY_RADIUS_KM=10

# Email Provider Configuration (Choose Option A or Option B for real email delivery)
# ----------------------------------------------------------------------------------
# Option A: Gmail SMTP (Use a 16-character Google App Password, NOT your regular password)
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password under Security -> App Passwords: name it "Pizza App"
# 3. Fill in below:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_real_gmail@gmail.com
# SMTP_PASS=your_16_character_app_password
# EMAIL_FROM="Pizza Slice" <your_real_gmail@gmail.com>

# Option B: Resend (Recommended for production: https://resend.com)
# RESEND_API_KEY=re_123456789abcdef
# EMAIL_FROM=Pizza Slice <onboarding@resend.dev>

# Default SMTP settings (Mailtrap / Custom SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=dummy_smtp_user
SMTP_PASS=dummy_smtp_password
EMAIL_FROM="Pizza Slice Delivery" <noreply@pizzadelivery.com>

# OTP Security Configuration
OTP_EXPIRY_MINUTES=10


# Admin Seed Credentials (for node src/seed/createAdmin.js)
ADMIN_SEED_EMAIL=admin@pizzadelivery.com
ADMIN_SEED_PASSWORD=AdminSecurePassword123!

# Low Stock Cron Job Configuration
LOW_STOCK_CRON=0 */6 * * *
ADMIN_NOTIFY_EMAIL=admin@pizzadelivery.com
